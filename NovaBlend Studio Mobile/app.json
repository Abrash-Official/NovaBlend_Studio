{
  "expo": {
    "name": "NovaBlend Studio",
    "slug": "novablend-studio-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "novablend",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0d12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.novablend.studio",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Import videos and photos into your NovaBlend projects.",
        "NSPhotoLibraryAddUsageDescription": "Save exported videos to your photo library.",
        "NSMicrophoneUsageDescription": "Record or attach audio for your edits."
      }
    },
    "android": {
      "package": "com.novablend.studio",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b0d12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow NovaBlend to access your media library.",
          "savePhotosPermission": "Allow NovaBlend to save exported videos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "githubReleasesApi": "https://api.github.com/repos/Abrash-Official/NovaBlend_Studio/releases/latest",
      "appUpdateChannel": "mobile"
    }
  }
}
