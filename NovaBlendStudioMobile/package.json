{
  "name": "novablend-studio-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "description": "NovaBlend Studio mobile editor for iOS and Android",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-media-library": "~58.0.14",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android --non-interactive",
    "prebuild:ios": "expo prebuild --platform ios --non-interactive",
    "build:android:apk": "expo prebuild --platform android --non-interactive && cd android && gradlew.bat assembleRelease",
    "eas:android": "eas build --platform android --profile preview",
    "eas:ios": "eas build --platform ios --profile preview",
    "eas:all": "eas build --platform all --profile preview"
  },
  "private": true
}
